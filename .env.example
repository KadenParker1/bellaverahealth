# Copy to .env for local tooling that reads dotenv (scripts, frontend).
# Spring itself reads the prod block below as real environment variables in the `prod` profile.
# For local backend dev, run `supabase start` instead - see application-local.properties.

# --- Local dev (supabase start - values are the fixed Supabase CLI demo defaults) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Database (prod / hosted Supabase) ---
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres?currentSchema=app
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# --- Auth (hosted Supabase) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1

# --- LLM (shell only - mock is the only adapter implemented so far) ---
BELLAVERA_LLM_PROVIDER=mock
BELLAVERA_LLM_MODEL=

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=https://bellavera.vercel.app,http://localhost:5173
